<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#1A1A2E"
    android:padding="6dp"
    android:gravity="center">

    <TextView android:id="@+id/ime_btn_selectall" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="全选" android:textColor="#CCCCFF" android:textSize="13sp" android:gravity="center" android:background="#25FFFFFF" android:layout_marginEnd="3dp"/>
    <TextView android:id="@+id/ime_btn_copy"      android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="复制" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" android:background="#407C6CFF" android:layout_marginEnd="3dp"/>
    <TextView android:id="@+id/ime_btn_paste"     android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="粘贴" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" android:background="#407C6CFF" android:layout_marginEnd="3dp"/>
    <TextView android:id="@+id/ime_btn_cut"       android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="剪切" android:textColor="#FF9999" android:textSize="13sp" android:gravity="center" android:background="#30FF6B6B" android:layout_marginEnd="3dp"/>
    <TextView android:id="@+id/ime_btn_undo"      android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="↩撤" android:textColor="#CCCCFF" android:textSize="13sp" android:gravity="center" android:background="#25FFFFFF" android:layout_marginEnd="3dp"/>
    <TextView android:id="@+id/ime_btn_redo"      android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="↪重" android:textColor="#CCCCFF" android:textSize="13sp" android:gravity="center" android:background="#25FFFFFF"/>

</LinearLayout>
